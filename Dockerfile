# ══════════════════════════════════════════════════════════════════
# Dockerfile —— 给魔搭创空间（以及任何 Docker 平台）看的"搭环境说明书"
#
# 【为什么要多出这个文件】
#
#   之前上 Render 用的是 render.yaml，那份说明书只管"装什么库、跑哪条命令"，
#   **环境本身是平台给的现成的**（它那儿早就有一个装好 Python 的空房间）。
#
#   魔搭创空间走的是另一条路：**它给你一个比空房间还空的房间**，
#   里面连 Python 都没有。所以说明书得从"装 Python"开始写起。
#
#   别被 Docker 这词吓到 —— 这份文件就是一张 4 步的清单，
#   跟你在自己电脑上装环境做的事一模一样：
#
#       ① 拿一个"里面已经有 Python 3.11 的"空房间     ← FROM
#       ② 把中文摆平（我们有中文文件名、中文笔记）    ← ENV
#       ③ 装库                                        ← RUN pip install
#       ④ 把代码搬进去，说清从哪扇门、几号门牌开张     ← COPY / EXPOSE / CMD
#
# 【一句话原理】平台那边没有你的电脑。它手里只有这个仓库，
#              唯一能读的就是这张清单 —— 照着它，从零把环境重建一遍。
# ══════════════════════════════════════════════════════════════════


# ── ① 地基：一个已经装好 Python 3.11 的官方空房间 ──────────────────
# `slim` = 精简版（约 130MB，完整版 1GB）。我们只要 Python，别的不要。
# 不写版本号的话默认会拿最新版 —— 写死是为了**明天跑和今天跑一模一样**。
FROM python:3.11-slim


# ── ② 把中文摆平 ──────────────────────────────────────────────────
# Linux 容器默认不是 UTF-8 编码。我们有 `服务.py` 这种中文文件名，
# 还有 28 篇中文笔记 —— 不设这几行，会冒出
# `ModuleNotFoundError: No module named 'web'` 这种看着毫不相干的怪错。
ENV LANG=C.UTF-8 \
    PYTHONUTF8=1 \
    PYTHONIOENCODING=utf-8 \
    PYTHONDONTWRITEBYTECODE=1


# ── ③ 装库 ────────────────────────────────────────────────────────
WORKDIR /app

# 先【只】把"装什么"拷进来，装完，再拷代码。
# 这样以后你只改代码时，"装库"这层还能用缓存 —— 不用每次重装几分钟。
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 现在才把代码全搬进来。`笔记\` 也在里头 —— 它是应用的一部分，不是私人物品。
COPY . .


# ── ④ 开张 ────────────────────────────────────────────────────────
# 魔搭创空间的硬规矩：**门牌号固定 7860**，写在平台文档里，不能改。
EXPOSE 7860

# 这行就是 render.yaml 里那条 startCommand，一字不差，只是挪了个地方住：
#
#     uvicorn web.服务:app --host 0.0.0.0 --port $PORT
#
# 两个老词（还是那两个，一个没多）：
#   0.0.0.0      —— 哪扇门来的都接（不能用 127.0.0.1，那是"只接我自己"）
#   ${PORT:-7860} —— 读环境变量 PORT；**如果平台没给，就用 7860**。
#                   `:-` 后面那截就是"没人告诉我时默认用啥"。
#                   （Render 会塞 PORT 给容器，魔搭固定 7860 —— 这句两种都接得住）
CMD uvicorn web.服务:app --host 0.0.0.0 --port ${PORT:-7860}
